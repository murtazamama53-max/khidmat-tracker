# Copy this file to .env for local development and fill in real values.
# Never commit .env. In production (Vercel, etc.) set these as real
# environment variables in your host's dashboard instead of a file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production -- the app refuses to start with the default
# placeholder value when FLASK_ENV=production.
SECRET_KEY=

# "development" (default) or "production". Only affects the SECRET_KEY
# safety check above -- set to "production" on your production deployment.
FLASK_ENV=development

# Leave blank locally to use SQLite at instance/khidmat.db.
# In production, set this to a managed PostgreSQL connection string, e.g.
# postgresql://user:password@host:5432/dbname
# (Vercel's filesystem is read-only and ephemeral, so SQLite cannot be
# relied on there -- see README "Deployment".)
DATABASE_URL=

# Google Calendar OAuth (only needed for calendar sync). Create credentials
# at https://console.cloud.google.com/apis/credentials and add the exact
# redirect URI below as an "Authorized redirect URI" on that OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev:
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/calendar/oauth/callback
# Production (replace with your real domain):
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/calendar/oauth/callback

# Optional -- if unset, defaults to true when FLASK_ENV=production and
# false otherwise, which is almost always what you want. Only set this
# explicitly to override that default (e.g. testing HTTPS locally).
SESSION_COOKIE_SECURE=

# Minutes of inactivity before auto-locking (only takes effect once you set
# a PIN under Settings in the app itself). Optional -- blank or invalid
# values safely fall back to 10, they will not crash startup.
PIN_AUTO_LOCK_MINUTES=10

# Only used for local SQLite backups (Settings > Backups). Ignored entirely
# when DATABASE_URL points at PostgreSQL -- back that up via your host's
# own tools instead. Leave blank to use instance/backups locally.
BACKUP_DIR=

# Not something you set yourself -- Vercel sets this automatically on
# every deployment, and the app uses its presence to detect that it's
# running on a read-only serverless filesystem (redirecting local-file
# paths like the SQLite fallback and backups to /tmp instead of instance/).
# VERCEL=1
